{
  "name": "llm-anatomy",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, animated lessons on how modern LLMs are built, trained and served.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include=\"math/**\" --test-coverage-include=\"shared/concepts.js\" --test-coverage-include=\"shared/router.js\" --test-coverage-include=\"shared/storage.js\" --test-coverage-include=\"shared/links.js\" --test-coverage-include=\"scripts/**\" \"tests/**/*.test.js\"",
    "serve": "node scripts/serve.js .",
    "validate": "node scripts/validate-data.js",
    "build:artifact": "node scripts/build-artifact.js",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
